+#[cfg(test)]
+mod global_modulation_tests {
+    use super::*;
+
+    #[test]
+    fn global_modulation_is_not_a_base_value() {
+        let params = ParamInfo::from([(1, Param {
+            name: String::from("Gain"),
+            module: String::new(),
+            cookie: None,
+            range: 0.0..=1.0,
+            default: 0.5,
+            flags: clap_sys::ext::params::CLAP_PARAM_IS_MODULATABLE,
+        })]);
+        let fuzzer = ParamFuzzer::new(&params);
+        let mut rng = new_prng();
+        let mut saw_modulation = false;
+        let mut saw_base = false;
+        for _ in 0..64 {
+            match fuzzer.generate_event(&mut rng).unwrap() {
+                Event::ParamMod(event) => {
+                    assert_eq!(event.header.type_, CLAP_EVENT_PARAM_MOD);
+                    assert_eq!(event.header.size as usize, std::mem::size_of::<clap_event_param_mod>());
+                    assert!((-0.5..=0.5).contains(&event.amount));
+                    saw_modulation = true;
+                }
+                Event::ParamValue(event) => {
+                    assert!((0.0..=1.0).contains(&event.value));
+                    saw_base = true;
+                }
+                _ => panic!("unexpected parameter event family"),
+            }
+        }
+        assert!(saw_modulation && saw_base);
+    }
+}
