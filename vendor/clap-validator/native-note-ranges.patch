+#[cfg(test)]
+mod native_note_tests {
+    use super::*;
+    use crate::plugin::ext::note_ports::NotePort;
+
+    #[test]
+    fn native_expression_values_follow_clap_domains() {
+        let config = NotePortConfig {
+            inputs: vec![NotePort {
+                supported_dialects: vec![clap_sys::ext::note_ports::CLAP_NOTE_DIALECT_CLAP],
+            }],
+            outputs: vec![],
+        };
+        let mut generator = NoteGenerator::new(&config).with_inconsistent_events();
+        let mut rng = new_prng();
+        let mut expressions = 0;
+        for _ in 0..20_000 {
+            if let Some(Event::NoteExpression(event)) = generator.generate_event(&mut rng, 0) {
+                assert!(event.value.is_finite());
+                match event.expression_id {
+                    CLAP_NOTE_EXPRESSION_VOLUME => assert!(event.value > 0.0 && event.value <= 4.0),
+                    CLAP_NOTE_EXPRESSION_TUNING => assert!((-120.0..=120.0).contains(&event.value), "invalid tuning {}", event.value),
+                    _ => assert!((0.0..=1.0).contains(&event.value)),
+                }
+                expressions += 1;
+            }
+        }
+        assert!(expressions > 0);
+    }
+}
